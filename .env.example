# Postgres connection string (e.g. from a free Neon.tech project)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Resend API key (https://resend.com) - free tier is plenty for this
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address for emails Resend sends. Until you verify your own
# domain in Resend, you MUST use their shared test sender below.
FROM_EMAIL=Office Tracker <onboarding@resend.dev>

# One or more manager email addresses, comma-separated
MANAGER_EMAIL=manager@example.com

# The public URL this app will be deployed at (no trailing slash).
# The Approve/Decline links in the manager's email are built from this.
APP_BASE_URL=https://your-app.vercel.app
