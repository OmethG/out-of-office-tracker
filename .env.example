# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FROM_EMAIL=Office Tracker <noreply@methg.com>

# Where new requests are emailed (comma-separate for more than one)
MANAGER_EMAIL=manager@methg.com

# The site's address, no trailing slash. Use http://localhost:3000 when running locally.
APP_BASE_URL=http://localhost:3000

# The manager's sign-in
MANAGER_USERNAME=manager@methg.com
MANAGER_PASSWORD=change-me

# Optional: signs the sign-in cookie. Falls back to DATABASE_URL if not set.
SESSION_SECRET=
